PORT=3000

# SerpApi (Google Shopping + product pages). _2 and _3 are optional backups: when one key runs out
# of searches, the server uses the next one.
SERPAPI_API_KEY=
SERPAPI_API_KEY_2=
SERPAPI_API_KEY_3=

# Google Gemini
GEMINI_API_KEY=

# MongoDB Atlas. Ask Dewa for the dev string. It must end in /fastdeal?appName=fastdeal-cluster
MONGODB_URI=

# Firebase Authentication (login only, not a database). Ask Marvel for the values.
# VITE_ values are built into the browser code, so they are not secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Email for target price alerts. Optional: without them, no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Firebase UID of demo@smu.edu.sg. Only npm run seed uses it.
DEMO_FIREBASE_UID=

# Playwright login for demo@smu.edu.sg (see README.txt)
E2E_DEMO_PASSWORD=
# Firebase UID of demo.user@smu.edu.sg (normal user)
DEMO_USER_FIREBASE_UID=
